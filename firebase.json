{
  "hosting": {
    "site": "disastermesh-app",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.exe"
    ],
    "headers": [
      {
        "source": "DisasterMesh.bin",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"DisasterMesh-App.apk\""
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/rescue",
        "destination": "/rescue.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
